{
  "name": "tetra-ts",
  "version": "0.1.0",
  "description": "Tetra in TypeScript: a four-operation arithmetic API with live three.js request telemetry",
  "license": "MIT",
  "author": "Giovanni Coutinho",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "DRAIN_DELAY_SECONDS=0 LOG_LEVEL=debug tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "lint": "tsc --noEmit && prettier --check src test"
  },
  "dependencies": {
    "fastify": "5.2.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "2.1.8",
    "prettier": "3.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
